# Keys stay in the backend process. Never copy them into VITE_* variables or frontend files.
# The launch scripts only permit their use when called with -AllowRealApi.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# This one directory owns SQLite, immutable artifacts, projects and deliveries.
NOVEL_DATA_DIR=./data
# Leave NOVEL_DATABASE_URL unset so SQLite follows NOVEL_DATA_DIR. Set it only
# when deliberately overriding the database location.
# NOVEL_DATABASE_URL=sqlite:///C:/absolute/path/to/novel_orchestrator.sqlite3
NOVEL_HOST=127.0.0.1
NOVEL_PORT=8000
NOVEL_OPENAI_MODEL=gpt-5.6
NOVEL_DEEPSEEK_MODEL=deepseek-v4-pro
# Optional OpenAI-compatible endpoints. Keep the trailing /v1 if the service requires it.
# NOVEL_OPENAI_BASE_URL=https://api.openai.com/v1
# NOVEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
NOVEL_PROVIDER_CONCURRENCY=2

# Do not persist NOVEL_TEST_FAKE_PROVIDER here. scripts/start.ps1 and dev.ps1
# set it explicitly from -Demo or -AllowRealApi for each process.
